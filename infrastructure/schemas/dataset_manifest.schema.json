{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura/dataset_manifest",
  "title": "AURA dataset manifest",
  "description": "Provenance record for one dataset. Written as YAML at data/manifests/DS-XXXX.yaml and validated against this schema. A dataset whose parent chain does not resolve back to a layer:raw dataset may not be used in a reported result.",
  "type": "object",
  "required": [
    "dataset_id", "name", "layer", "source", "generation_date", "generation_method",
    "software_version", "git_commit", "configuration", "configuration_sha256",
    "random_seed_base", "parent_dataset", "checksum_manifest", "units",
    "sampling_rate_hz", "frozen", "description"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_id": { "type": "string", "pattern": "^DS-[0-9]{4}$" },
    "name": { "type": "string" },
    "layer": { "enum": ["raw", "processed", "derived", "results"] },
    "source": { "enum": ["simulation", "external", "derived"] },
    "generation_date": { "type": "string", "format": "date" },
    "generation_method": { "type": "string", "description": "Repo-relative path of the script that produced it" },
    "software_version": { "type": "string" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "git_dirty": { "type": "boolean", "default": false,
      "description": "If true this dataset is NOT reproducible and may not support a confirmatory claim" },
    "configuration": { "type": "string" },
    "configuration_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "random_seed_base": { "type": ["integer", "null"] },
    "n_runs": { "type": ["integer", "null"], "minimum": 1 },
    "parent_dataset": {
      "oneOf": [
        { "type": "null", "description": "Only permitted when layer == raw" },
        { "type": "string", "pattern": "^DS-[0-9]{4}$" },
        { "type": "array", "items": { "type": "string", "pattern": "^DS-[0-9]{4}$" } }
      ]
    },
    "checksum_manifest": { "type": "string" },
    "units": { "type": "string", "description": "Explicit units. Angles must state rad or deg" },
    "sampling_rate_hz": { "type": ["number", "object", "null"] },
    "frozen": { "type": "boolean",
      "description": "If true this dataset may never be regenerated under this ID" },
    "frozen_date": { "type": ["string", "null"], "format": "date" },
    "license": { "type": "string" },
    "external_source_id": { "type": ["string", "null"], "pattern": "^EXT-[0-9]{2}$" },
    "superseded_by": { "type": ["string", "null"], "pattern": "^DS-[0-9]{4}$" },
    "description": { "type": "string", "minLength": 20 }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "raw" } } },
      "then": { "properties": { "parent_dataset": { "type": "null" } } }
    },
    {
      "if": { "properties": { "layer": { "enum": ["processed", "derived"] } } },
      "then": { "properties": { "parent_dataset": { "not": { "type": "null" } } } }
    },
    {
      "if": { "properties": { "frozen": { "const": true } } },
      "then": { "required": ["frozen_date"] }
    }
  ]
}
